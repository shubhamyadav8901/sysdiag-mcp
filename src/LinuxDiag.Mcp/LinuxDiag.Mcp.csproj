<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net9.0 with the whole assembly marked Linux-only (AssemblyInfo.cs), so the platform analyzer
         checks every call as windiag's net9.0-windows TFM does there. -->
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>LinuxDiag.Mcp</AssemblyName>
    <RootNamespace>LinuxDiag.Mcp</RootNamespace>
    <Company>Shubham Yadav</Company>
    <Product>LinuxDiag</Product>
    <AssemblyTitle>LinuxDiag MCP Server</AssemblyTitle>
    <Description>Linux diagnostics MCP server.</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Without this a self-contained build needs libicu at startup, which minimal Debian hosts do not
         have: the service would fail before logging a line, on exactly the machines nobody can log
         into to find out why. Nothing here depends on culture-specific formatting. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="9.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diag.Mcp.Core\Diag.Mcp.Core.csproj" />
    <ProjectReference Include="..\Diag.Mcp.Server\Diag.Mcp.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Diag.Mcp.Core" />
    <Using Include="Diag.Mcp.Server" />
    <Using Include="Diag.Mcp.Server.Capabilities" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinuxDiag.Mcp.Tests" />
  </ItemGroup>

</Project>
