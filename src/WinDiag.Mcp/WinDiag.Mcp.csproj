<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net9.0-windows, not net9.0: this server is Windows-only by nature (Restart Manager,
         ServiceController, EventLogReader, ETW) and the TFM makes that explicit rather than
         letting the platform-compatibility analyzer warn on every call. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>WinDiag.Mcp</AssemblyName>
    <RootNamespace>WinDiag.Mcp</RootNamespace>

    <!-- Icon and version metadata, so the exe is identifiable in Explorer, Task Manager and endpoint
         reports rather than a nameless binary. file_signatures and process_modules surface Company and
         the versions below; the icon is the Windows-magnifier logo in Resources. -->
    <ApplicationIcon>Resources\windiag.ico</ApplicationIcon>
    <Company>Shubham Yadav</Company>
    <Product>WinDiag</Product>
    <AssemblyTitle>WinDiag MCP Server</AssemblyTitle>
    <Description>Windows enterprise-debugging MCP server, backed by Sysinternals.</Description>
    <Copyright>Copyright © 2026 Shubham Yadav</Copyright>
    <!-- Keep ProductVersion a clean x.y.z rather than x.y.z+<commit>, which is what file_signatures reports. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!--
      Step 3 ships this as a single self-contained exe to copy onto a target machine, published with
      SelfContained, PublishSingleFile and IncludeNativeLibrariesForSelfExtract set on the command
      line (see README).

      Deliberately NOT set as project properties: a RID-specific, single-file project referenced by
      the non-RID-specific test projects trips SDK restore errors. Keeping it on the publish command
      keeps `dotnet build` and `dotnet test` clean.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.12" />
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diag.Mcp.Core\Diag.Mcp.Core.csproj" />
    <ProjectReference Include="..\Diag.Mcp.Server\Diag.Mcp.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FileTransferException and PathScope moved to the shared core; one global using keeps the ~20
         call sites unchanged instead of editing each of them. -->
    <Using Include="Diag.Mcp.Core" />
    <!-- The shared server kit: gate, filters, file transfer and the engines behind the gated tools. -->
    <Using Include="Diag.Mcp.Server" />
    <Using Include="Diag.Mcp.Server.Capabilities" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded, not copied alongside: a single-file publish has no directory to read it from.
         Hand-exported from the Procmon GUI; it pins the capture filter set. -->
    <EmbeddedResource Include="Resources\windiag.pmc" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinDiag.Mcp.Tests" />
    <InternalsVisibleTo Include="WinDiag.Mcp.OnTarget" />
  </ItemGroup>

</Project>
