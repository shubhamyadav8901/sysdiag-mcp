<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net9.0-windows, not net9.0: this server is Windows-only by nature (Restart Manager,
         ServiceController, EventLogReader, ETW) and the TFM makes that explicit rather than
         letting the platform-compatibility analyzer warn on every call. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>WinDiag.Mcp</AssemblyName>
    <RootNamespace>WinDiag.Mcp</RootNamespace>

    <!--
      Step 3 ships this as a single self-contained exe to copy onto a target machine, published with
      SelfContained, PublishSingleFile and IncludeNativeLibrariesForSelfExtract set on the command
      line (see README).

      Deliberately NOT set as project properties: a RID-specific, single-file project referenced by
      the non-RID-specific test projects trips SDK restore errors. Keeping it on the publish command
      keeps `dotnet build` and `dotnet test` clean.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded, not copied alongside: a single-file publish has no directory to read it from.
         Hand-exported from the Procmon GUI; it pins the capture filter set. -->
    <EmbeddedResource Include="Resources\windiag.pmc" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinDiag.Mcp.Tests" />
    <InternalsVisibleTo Include="WinDiag.Mcp.OnTarget" />
  </ItemGroup>

</Project>
