<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0: shared by the Windows server and the Linux server. Anything Windows-only belongs in
         the server that needs it. The relay must never reference this project: it would pull a web
         server into a stdio client. -->
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Diag.Mcp.Server</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diag.Mcp.Core\Diag.Mcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Diag.Mcp.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Diag.Mcp.Server.Tests" />
    <InternalsVisibleTo Include="WinDiag.Mcp.Tests" />
  </ItemGroup>

</Project>
